{
  "name": "page-harness",
  "version": "0.1.13",
  "description": "Point it at any frontend URL and get Pick / Artifacts / Chat on the page, driven by the coding agent CLI on your machine.",
  "keywords": [
    "agent",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "devtools",
    "frontend",
    "live-preview"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/page-harness.git"
  },
  "homepage": "https://cocofhu.github.io/page-harness-site/",
  "type": "module",
  "bin": {
    "page-harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "AGENTS.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "docs/*.md",
    "docs/*.svg",
    "docs/*.png",
    "docs/*.webp"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsup",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "licenses": "node scripts/third-party-licenses.mjs",
    "prepublishOnly": "npm run build && npm run licenses"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@page-agent/page-controller": "^1.12.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "dompurify": "^3.4.16",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "marked": "^18.0.14",
    "shiki": "^4.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
